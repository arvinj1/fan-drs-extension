{
  "manifest_version": 3,
  "name": "Fan DRS Review",
  "version": "0.3.1",
  "description": "Review close cricket dismissals on YouTube: captures replays on cricket videos and shows what the frames can and can’t prove. Runs on your device.",
  "action": {
    "default_title": "Fan DRS Review"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/shared/review.js",
        "src/content/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidebar/sidebar.html"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "commands": {
    "review-moment": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Review the last 12 seconds"
    }
  }
}
