{
  "manifest_version": 3,
  "name": "Fan DRS Review",
  "version": "0.2.0",
  "description": "Review cricket replays on YouTube: mark a window and see which frames were captured. Evidence only; runs on your device.",
  "action": {
    "default_title": "Fan DRS Review"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/content/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidebar/sidebar.html"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
