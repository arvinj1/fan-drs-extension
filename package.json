{
  "name": "fan-drs-extension",
  "version": "0.3.1",
  "private": true,
  "description": "Fan DRS Review Chrome extension (MV3). No runtime dependencies.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check.js --allow-known",
    "test": "node --test test/*.test.js",
    "verify": "npm run check && npm test",
    "smoke": "node test/browser/smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.56"
  }
}
